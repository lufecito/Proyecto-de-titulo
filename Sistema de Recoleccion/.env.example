DEBUG=True
FLASK_APP=run.py
FLASK_DEBUG=1

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value
APP_NAME=Ticket Kanban
SQLITE_PATH=apps/db.sqlite3
REPORTS_DIR=reports

# Optional Google OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=
GOOGLE_AUTO_PROVISION=False

# Optional external database
# Con Docker Compose: docker compose --profile postgres up --build
# DB_ENGINE=postgresql
# DB_NAME=ticketflow
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=ticketflow
# DB_PASS=replace-me

# ------------------------------------------------------------------
# Módulo de recolección: cartografía, optimización y caché
# ------------------------------------------------------------------
# MAP_PROVIDER: auto | ors | fake
#   auto -> openrouteservice si ORS_API_KEY está definida, si no modo demostración.
#   ors  -> exige ORS_API_KEY.
#   fake -> modo demostración sin red (estimaciones NO viales).
MAP_PROVIDER=auto
# ORS_API_KEY=
# ORS_BASE_URL=https://api.openrouteservice.org
# ORS_GEOCODE_BASE_URL=https://api.openrouteservice.org/geocode
# ORS_PROFILE=driving-hgv
# ORS_GEOCODE_COUNTRY=CHL
# ORS_MAX_RESPONSE_BYTES=2000000

# Mapas web (Leaflet). La URL de teselas es configurable para cambiar de proveedor.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# CHILE_LIMITS_SERVICE_URL=https://rest-sit.mop.gob.cl/arcgis/rest/services/MAPA_BASE/LIMITES/MapServer

# Timeout y reintentos (segundos).
# MAP_HTTP_TIMEOUT_SECONDS=15
# MAP_HTTP_RETRIES=2

# Caché persistente de geocodificación y matrices.
# MAP_CACHE_DIR=map_cache
# GEOCODE_CACHE_TTL_SECONDS=2592000
# MATRIX_CACHE_TTL_SECONDS=604800
# MAP_CACHE_MAX_ENTRIES=2000

# Límite de tiempo del optimizador local (segundos).
# OPTIMIZER_TIME_LIMIT_SECONDS=30

# Zona horaria operacional por defecto.
# OPERATIONAL_TIMEZONE=America/Santiago

# Credenciales de demostración (solo para desarrollo; no aptas para producción).
# DEMO_ADMIN_PASSWORD=
# DEMO_DESPACHADOR_PASSWORD=
# DEMO_CONDUCTOR_PASSWORD=
